import socket
import argparse

def calculate_checksum(payload: str) -> int:
    """
    Calculates the Microgate ALFA protocol checksum.
    Initial value is 30. Each character (7-bit) is added to the sum,
    and then the sum is masked to 7-bit (modulo 128).
    """
    checksum = 30
    for char in payload:
        # Add the 7-bit value of the character to the checksum
        byte_val = ord(char) & 127
        checksum = (checksum + byte_val) & 127
    return checksum

def construct_packet(payload: str) -> bytes:
    """
    Constructs the ALFA protocol packet.
    Packet structure: [ESC] [PAYLOAD] [ETX] [CHECKSUM]
    """
    esc = 27
    etx = 3
    checksum = calculate_checksum(payload)
    
    packet = bytearray()
    packet.append(esc)
    packet.extend(payload.encode('ascii'))
    packet.append(etx)
    packet.append(checksum)
    
    return bytes(packet)

def send_to_display(ip: str, port: int, text: str, row: str = "A", col: int = 0, width: int = 45):
    """
    Formats the message and sends it to the Microtab LED display.
    """
    # Format the payload: Row ID + 'S' + Column ID (2 digits) + text + space padding
    # Example for Row A, Col 0: "AS00hello"
    payload = f"{row}S{col:02d}{text}"
    
    # Pad with spaces to clear any existing long strings (default width 45)
    if len(payload) < width:
        payload = payload.ljust(width)
    
    packet = construct_packet(payload)
    
    print(f"Connecting to {ip}:{port}...")
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect((ip, port))
            print(f"Sending packet ({len(packet)} bytes): {packet.hex(' ')}")
            s.sendall(packet)
            print("Message sent successfully!")
    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Send text to Microgate Microtab LED display (ALFA protocol).")
    parser.add_argument("--ip", type=str, default="[IP_ADDRESS]", help="IP address of the display board")
    parser.add_argument("--port", type=int, default=4000, help="TCP port (default 4000)")
    parser.add_argument("--text", type=str, default="hello", help="Text to display")
    parser.add_argument("--row", type=str, default="A", help="Row letter (A, B, C...)")
    parser.add_argument("--col", type=int, default=0, help="Column index (00, 01...)")
    parser.add_argument("--width", type=int, default=0, help="Padding width (default 0)")
    
    args = parser.parse_args()
    
    send_to_display(args.ip, args.port, args.text, args.row, args.col, args.width)
